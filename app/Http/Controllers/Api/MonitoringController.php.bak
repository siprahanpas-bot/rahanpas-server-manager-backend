<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Services\SshConnectionService;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Log;
use RuntimeException;
use Throwable;

class MonitoringController extends Controller
{
    public function show(
        Request $request,
        int $id,
        SshConnectionService $ssh
    ): JsonResponse {
        $server = $request->user()
            ->managedServers()
            ->findOrFail($id);

        try {
            $metrics = $ssh->collectMetrics($server);

            $server->forceFill([
                'status' => 'online',
                'last_checked_at' => now(),
                'last_error' => null,
            ])->save();
        } catch (Throwable $exception) {
            $message = $exception instanceof RuntimeException
                ? $exception->getMessage()
                : 'Terjadi kesalahan saat mengambil data monitoring.';

            $server->forceFill([
                'status' => 'error',
                'last_checked_at' => now(),
                'last_error' => $message,
            ])->save();

            return response()->json([
                'message' => $message,
                'server_status' => [
                    'id' => $server->id,
                    'status' => 'error',
                ],
            ], 502);
        }

        return response()->json([
            'message' => 'Monitoring berhasil.',
            'metrics' => $metrics,
            'server_status' => [
                'id' => $server->id,
                'status' => 'online',
                'last_checked_at' => $server->fresh()->last_checked_at,
            ],
        ]);
    }


    public function history(Request $request, int $id): JsonResponse
    {
        $validated = $request->validate([
            'period' => 'sometimes|in:1h,6h,24h,7d',
        ]);

        $period = $validated['period'] ?? '1h';

        $cutoff = match ($period) {
            '1h' => now()->subHour(),
            '6h' => now()->subHours(6),
            '24h' => now()->subDay(),
            '7d' => now()->subDays(7),
        };

        // Hanya histori milik server yang dimiliki user login.
        $server = $request->user()
            ->managedServers()
            ->findOrFail($id);

        $history = $server->metricHistories()
            ->where('collected_at', '>=', $cutoff)
            ->orderBy('collected_at')
            ->get([
                'id',
                'hostname',
                'cpu_usage_percent',
                'memory_usage_percent',
                'memory_used_mb',
                'memory_total_mb',
                'swap_usage_percent',
                'disk_usage_percent',
                'disk_used_gb',
                'disk_total_gb',
                'network_rx_bytes',
                'network_tx_bytes',
                'load_average',
                'collected_at',
            ]);

        $rawCount = $history->count();
        $maxPoints = 120;

        if ($rawCount > $maxPoints) {
            $sampled = collect();
            $step = ($rawCount - 1) / ($maxPoints - 1);
            for ($i = 0; $i < $maxPoints; $i++) {
                $idx = (int) round($i * $step);
                if (isset($history[$idx])) {
                    $sampled->push($history[$idx]);
                }
            }
            $history = $sampled->unique('id')->values();
        }

        return response()->json([
            'message' => 'Monitoring history berhasil diambil.',
            'server_id' => $server->id,
            'period' => $period,
            'count' => $history->count(),
            'raw_count' => $rawCount,
            'history' => $history,
        ]);
    }

}
