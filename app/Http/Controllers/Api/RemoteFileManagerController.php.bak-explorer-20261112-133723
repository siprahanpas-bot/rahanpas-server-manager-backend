    public function download(
        Request $request,
        int $id,
        RemoteFileManagerService $fileManager
    ) {
        $data = $request->validate([
            'path' => ['required', 'string', 'max:4096'],
        ]);

        $server = $request->user()
            ->managedServers()
            ->findOrFail($id);

        $download = null;

        try {
            $download = $fileManager->prepareDownload(
                $server,
                $data['path']
            );

            $localPath = $download['local_path'];

            // Hilangkan karakter kontrol agar nama file aman untuk header HTTP.
            $filename = preg_replace(
                '/[\\x00-\\x1F\\x7F]/',
                '_',
                $download['filename']
            );

            if (!is_string($filename) || $filename === '') {
                $filename = 'download';
            }

            return response()->streamDownload(
                function () use ($localPath) {
                    $stream = null;

                    try {
                        $stream = @fopen($localPath, 'rb');

                        if ($stream === false) {
                            throw new \RuntimeException(
                                'Gagal membuka temporary file download.'
                            );
                        }

                        fpassthru($stream);
                    } finally {
                        if (is_resource($stream)) {
                            fclose($stream);
                        }

                        @unlink($localPath);
                    }
                },
                $filename,
                [
                    'Content-Type' => 'application/octet-stream',
                    'Content-Length' => (string) $download['size'],
                    'X-Content-Type-Options' => 'nosniff',
                ]
            );
        } catch (Throwable $exception) {
            if (
                is_array($download) &&
                isset($download['local_path']) &&
                is_file($download['local_path'])
            ) {
                @unlink($download['local_path']);
            }

            return response()->json([
                'message' => $exception->getMessage(),
            ], 502);
        }
    }

    public function inspectStorageDeviceFormat(
