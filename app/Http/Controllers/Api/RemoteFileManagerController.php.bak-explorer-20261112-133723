            ], 502);
        }
    }

    public function formatStorageDevice(
        Request $request,
        int $id,
        RemoteFileManagerService $fileManager
    ): JsonResponse {
        $data = $request->validate([
            'device_path' => [
                'required',
                'string',
                'max:255',
                'regex:/^\\/dev\\/[A-Za-z0-9._-]+$/',
            ],
            'fingerprint' => [
                'required',
                'string',
                'regex:/^[a-f0-9]{64}$/',
            ],
            'filesystem' => [
                'required',
                'string',
                'in:ext4,xfs,btrfs',
            ],
            'label' => [
                'nullable',
                'string',
                'max:12',
                'regex:/^[A-Za-z0-9._-]*$/',
            ],
            'confirmation' => [
                'required',
                'string',
                'max:255',
                'same:device_path',
            ],
        ]);

        $server = $request->user()
            ->managedServers()
            ->findOrFail($id);

        try {
            $result = $fileManager->formatStorageDevice(
                $server,
                $data['device_path'],
                $data['fingerprint'],
                $data['filesystem'],
                $data['label'] ?? '',
                $data['confirmation']
            );

            return response()->json([
                'server_id' => $server->id,
                'data' => $result,
            ]);
        } catch (Throwable $exception) {
            return response()->json([
                'message' => $exception->getMessage(),
            ], 502);
        }
    }

