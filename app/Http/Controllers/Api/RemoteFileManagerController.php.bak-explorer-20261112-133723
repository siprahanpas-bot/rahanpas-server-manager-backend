        int $id,
        RemoteFileManagerService $fileManager
    ): JsonResponse {
        $data = $request->validate([
            'device_path' => [
                'required',
                'string',
                'max:255',
                'regex:/^\\/dev\\/[A-Za-z0-9._-]+$/',
            ],
