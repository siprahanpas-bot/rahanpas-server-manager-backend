    public function files(
        Request $request,
        int $id,
        RemoteFileManagerService $fileManager
    ): JsonResponse {
        $data = $request->validate([
            'path' => ['nullable', 'string', 'max:4096'],
        ]);

        $server = $request->user()
            ->managedServers()
            ->findOrFail($id);

        try {
            $result = $fileManager->listDirectory(
                $server,
                $data['path'] ?? null
            );

            return response()->json([
                'server_id' => $server->id,
                'data' => $result,
            ]);
        } catch (Throwable $exception) {
            return response()->json([
                'message' => $exception->getMessage(),
            ], 502);
        }
    }

