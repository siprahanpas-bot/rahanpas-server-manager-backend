<?php

use App\Http\Controllers\Api\AuthController;
use App\Http\Controllers\Api\ServerController;
use App\Http\Controllers\Api\MonitoringController;
use App\Http\Controllers\Api\RemoteFileManagerController;
use Illuminate\Support\Facades\Route;

Route::post('/register', [AuthController::class, 'register'])->middleware('throttle:5,1');
Route::post('/register/resend-verification', [AuthController::class, 'resendVerification'])->middleware('throttle:3,10');
Route::post('/register/verify-email', [AuthController::class, 'verifyEmail'])->middleware('throttle:10,1');
Route::post('/register/set-password', [AuthController::class, 'setPassword'])->middleware('throttle:10,1');
Route::post('/login', [AuthController::class, 'login'])->middleware('throttle:10,1');

Route::middleware('auth:sanctum')->group(function () {
    Route::post('/logout', [AuthController::class, 'logout']);
    Route::get('/me', [AuthController::class, 'me']);

    Route::get('/servers', [ServerController::class, 'index'])->middleware('permission:server.view');
    Route::post('/servers', [ServerController::class, 'store'])->middleware('permission:server.create');
    Route::get('/servers/{id}', [ServerController::class, 'show'])->middleware('permission:server.view');

    Route::get('/servers/{id}/monitoring', [MonitoringController::class, 'show'])
        ->middleware(['permission:monitoring.view', 'throttle:120,1']);
    Route::get('/servers/{id}/monitoring/history', [MonitoringController::class, 'history'])
        ->middleware(['permission:monitoring.view', 'throttle:120,1']);

    Route::get('/servers/{id}/files', [RemoteFileManagerController::class, 'files'])
        ->middleware(['permission:files.view', 'throttle:120,1']);
    Route::post('/servers/{id}/files/directories', [RemoteFileManagerController::class, 'createDirectory'])
        ->middleware(['permission:files.create', 'throttle:120,1']);
    Route::patch('/servers/{id}/files/rename', [RemoteFileManagerController::class, 'renameEntry'])
        ->middleware(['permission:files.rename', 'throttle:120,1']);
    Route::delete('/servers/{id}/files/delete', [RemoteFileManagerController::class, 'deleteEntry'])
        ->middleware(['permission:files.delete', 'throttle:60,1']);

    Route::get('/servers/{id}/storage-devices', [RemoteFileManagerController::class, 'storageDevices'])
        ->middleware(['permission:storage.view', 'throttle:storage-devices']);
    Route::post('/servers/{id}/storage-devices/mount', [RemoteFileManagerController::class, 'mountStoragePartition'])
        ->middleware(['permission:storage.mount', 'throttle:storage-mount']);
    Route::post('/servers/{id}/storage-devices/unmount', [RemoteFileManagerController::class, 'unmountStoragePartition'])
        ->middleware(['permission:storage.unmount', 'throttle:storage-unmount']);
    Route::post('/servers/{id}/storage-devices/inspect-format', [RemoteFileManagerController::class, 'inspectStorageDeviceFormat'])
        ->middleware(['permission:storage.view', 'throttle:120,1']);
    Route::post('/servers/{id}/storage-devices/format', [RemoteFileManagerController::class, 'formatStorageDevice'])
        ->middleware(['permission:storage.format', 'throttle:10,1']);

    Route::post('/servers/{id}/files/upload', [RemoteFileManagerController::class, 'upload'])
        ->middleware(['permission:files.upload', 'throttle:120,1']);
    Route::get('/servers/{id}/files/download', [RemoteFileManagerController::class, 'download'])
        ->middleware(['permission:files.view', 'throttle:120,1']);

    Route::put('/servers/{id}', [ServerController::class, 'update'])->middleware('permission:server.update');
    Route::post('/servers/{id}/discover-host-key', [ServerController::class, 'discoverHostKey'])
        ->middleware('permission:server.connect');
    Route::post('/servers/{id}/test-connection', [ServerController::class, 'testConnection'])
        ->middleware('permission:server.connect');
    Route::delete('/servers/{id}', [ServerController::class, 'destroy'])->middleware('permission:server.delete');
});
